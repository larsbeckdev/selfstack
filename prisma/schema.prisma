generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                 String   @id @default(cuid())
  email              String   @unique
  username           String   @unique
  name               String
  password           String
  image              String?
  role               String   @default("user") // user | editor | admin
  locale             String   @default("de")
  emailVerified      Boolean  @default(false)
  mustChangePassword Boolean  @default(false)
  themePreset        String   @default("default")
  customColors       String?
  theme              String   @default("system") // light | dark | system
  sidebarOpen        Boolean  @default(true)
  twoFactorEnabled   Boolean  @default(false)
  twoFactorSecret    String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  boards       Board[]
  boardMembers BoardMember[]
  orgMembers   OrganizationMember[]
  sessions     Session[]
}

model SystemSetting {
  key   String @id
  value String
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Board {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  icon      String   @default("layout-dashboard")
  iconUrl   String?
  isPublic  Boolean  @default(false)
  order     Int      @default(0)
  /// "auto" | "free" — controls whether categories snap to auto-flow or free grid
  layoutMode String  @default("auto")
  userId    String
  /// Optional organization that owns this board. When set the slug is
  /// prefixed with `@<org>/` and only explicit members (via BoardMember)
  /// can access it.
  orgId     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [orgId], references: [id], onDelete: SetNull)
  categories   Category[]
  members      BoardMember[]
}

model BoardMember {
  id      String @id @default(cuid())
  role    String @default("viewer") // viewer | editor
  boardId String
  userId  String

  board Board @relation(fields: [boardId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([boardId, userId])
}

model Category {
  id              String  @id @default(cuid())
  name            String
  icon            String  @default("folder")
  iconUrl         String?
  color           String  @default("#6366f1")
  bgColor         String?
  borderColor     String?
  borderMatchesBg Boolean @default(false)
  /// Position on the board grid (in grid units, 1u = 72px).
  x               Int     @default(0)
  y               Int     @default(0)
  w               Int     @default(12)
  h               Int     @default(4)
  boardId         String

  board  Board   @relation(fields: [boardId], references: [id], onDelete: Cascade)
  groups Group[]
}

model Group {
  id              String  @id @default(cuid())
  name            String
  icon            String  @default("grid-3x3")
  iconUrl         String?
  bgColor         String?
  borderColor     String?
  borderMatchesBg Boolean @default(false)
  /// "grid" | "list"
  layout          String  @default("grid")
  /// Position inside the parent category grid.
  x               Int     @default(0)
  y               Int     @default(0)
  w               Int     @default(4)
  h               Int     @default(4)
  categoryId      String

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  tiles    Tile[]
}

model Tile {
  id              String  @id @default(cuid())
  name            String
  icon            String  @default("square")
  iconUrl         String?
  color           String  @default("#6366f1")
  bgColor         String?
  borderColor     String?
  borderMatchesBg Boolean @default(false)
  url             String?
  description     String?
  statusCheck     Boolean @default(false)
  /// "small" (1x1) | "default" (2x2) | "large" (4x4)
  size            String  @default("default")
  /// Position inside the parent group grid.
  x               Int     @default(0)
  y               Int     @default(0)
  groupId         String

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  icon      String   @default("building-2")
  iconUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members OrganizationMember[]
  boards  Board[]
}

model OrganizationMember {
  id     String @id @default(cuid())
  /// "owner" | "admin" | "editor" | "member"
  role   String @default("member")
  orgId  String
  userId String

  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
}
